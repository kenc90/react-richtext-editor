{
  "name": "@kenc90/react-richtext-editor",
  "version": "0.3.0",
  "description": "A lightweight WYSIWYG editor component for React",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kenc90/react-richtext-editor.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/react-richtext-editor.umd.cjs",
  "module": "./dist/react-richtext-editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-richtext-editor.js",
      "require": "./dist/react-richtext-editor.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "tsc -b && vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
